# Copy to apps/ios/.env (git-ignored). Expo loads EXPO_PUBLIC_* values into the app bundle.

# Google Maps SDK for iOS key, restricted to the iOS bundle ID (app.json ios.bundleIdentifier).
# Without it, Discover shows the demo's illustrated London map instead of the native Google map.
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=

# Real API base URL. Not needed for `pnpm ios:preview`, which runs on the built-in preview data.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
