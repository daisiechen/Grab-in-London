{
  "expo": {
    "name": "Fancy",
    "slug": "fancy",
    "scheme": "fancy",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "web"
    ],
    "ios": {
      "bundleIdentifier": "com.example.fancy.dev",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en"
        ],
        "CFBundleAllowMixedLocalizations": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Fancy uses your photo library so you can choose a profile photo.",
          "cameraPermission": "Fancy uses your camera so you can take a profile photo.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiBaseUrl": "http://localhost:3000",
      "legalBaseUrl": "https://fancyabite.uk"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
