{
  "expo": {
    "name": "Fancy",
    "slug": "fancy",
    "scheme": "fancy",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "web"
    ],
    "ios": {
      "bundleIdentifier": "com.example.fancy.dev",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiBaseUrl": "http://localhost:3000"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
