# Public browser-only Maps JavaScript key. Restrict HTTP referrers and enabled API in Google Cloud.
# Never reuse the server-side Places key here. VITE_ values are included in browser assets.
VITE_PUBLIC_GOOGLE_MAPS_KEY=
# Your JavaScript Map ID (required in production for Advanced Markers).
# Local development may use Google's DEMO_MAP_ID; production never supplies that default.
VITE_PUBLIC_GOOGLE_MAPS_ID=
