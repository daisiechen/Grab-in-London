        "Idempotency-Key",
        "original If-Match or null"
      ],
      "mechanism": "defineWrite: replay original method/path/body/key and original If-Match; actor authorization and privacy checks revalidated before sealed response replay. No invented GET /commands endpoint.",
      "currentReadIsNotIntentProof": true,
      "onDefinite409": "Retain draft, load authoritative current fact, explicit human confirmation forms new intent. Do not silently substitute a new If-Match.",
      "versionSource": {
        "decideApplication": "Application.version",
        "editMeal/declareBooking/cancelMeal": "Meal.version",
        "createMeal/confirmVenue": "no If-Match; createMeal attemptId stays same during same publication intent"
      },
      "publish": "Keep exact serialized body/key while response unknown; getMeal/myMeals/current matching title is not proof. A changed valid draft is a new explicit intent, not implicit retry."
    },
    "identity": "Reuse I1 contracts: OTP start clientRequestId is metadata only; verify/OAuth callback/handoff/rotating refresh are single-use credential protocols, never blind ordinary-write replay; logout/account-change clears private drafts/results.",
    "assistant": "Use same requestId + sessionId/generation and pollAI; editor replacement validates draftId/editorVersion/replaceConfirmed; resourceKey/CAS protocol is not ordinary idempotency table replay. Late/account-changed/expired responses are discarded."
