# Template for /etc/fancy/fancy.env (root:root 0600, loaded by systemd EnvironmentFile).
# secrets.sh turns this into the real file on the server; values never enter Git or chat.
#
# Every line is KEY=<value or directive>. Directives:
#   @ask              owner types it (shown while typing; not a secret)   required
#   @ask-optional     same, may be left empty
#   @secret           owner types it with echo off                         required
#   @secret-optional  same, may be left empty
#   @generate         random 64-hex value generated on the server
#   @database         generated database password + DATABASE_URL for the local cluster
#   @deletion-keyring generated AES-256-GCM key ring (version + keys JSON, generated together)
#   @unset            must stay absent in production
# A literal value is a default: written when the key is missing, existing values are kept.
# PORT is not listed on purpose: the systemd units set it (EnvironmentFile would override).
# Every key read by packages/config must appear here (enforced by
# infra/tests/seoul-deploy.release.test.ts).

ENVIRONMENT=production
# Local PostgreSQL 17 on 127.0.0.1, TLS verified against the server's own CA.
DATABASE_URL=@database

AUTH_ADAPTER=auth0
PLACES_ADAPTER=google
MAIL_ADAPTER=provider
# Ask Fancy is off for this release (owner decision 2026-10-28).
AI_PROVIDER=disabled
DEV_FIXED_OTP=@unset

WEB_ORIGIN=https://fancyabite.uk
ADMIN_URL=https://fancyabite.uk/admin/
SESSION_SECRET=@generate
IOS_REDIRECT_URI=fancy://auth/callback

# Auth0 UK tenant: Regular Web Application used by the API (BFF).
AUTH0_DOMAIN=@ask
AUTH0_CLIENT_ID=@ask
AUTH0_CLIENT_SECRET=@secret
# Machine-to-machine app for identity deletion on account removal (recommended; without it
# deletions finish as NEEDS_SUPPORT and need manual handling).
AUTH0_MANAGEMENT_CLIENT_ID=@ask-optional
AUTH0_MANAGEMENT_CLIENT_SECRET=@secret-optional

# Server-side Places API (New) key. Never the iOS or Web key; restrict it to Places API (New)
# and to this server's egress IP in Google Cloud.
GOOGLE_MAPS_API_KEY=@secret

DEEPSEEK_API_KEY=@unset
AI_BUNDLE_FILE=@unset

# Resend, verified domain mail.fancyabite.uk (Ireland region), sending-only key.
RESEND_API_KEY=@secret
RESEND_FROM=Fancy <noreply@mail.fancyabite.uk>
# Signing secret of the Resend webhook pointing at https://fancyabite.uk/v1/webhooks/resend
RESEND_WEBHOOK_SECRET=@secret-optional

DELETION_MAIL_KEY_VERSION=@deletion-keyring
DELETION_MAIL_KEYS_JSON=@deletion-keyring

# Leave empty at first. Set (secrets.sh --reset ANALYTICS_COVERAGE_START) only after API,
# Web and iOS telemetry are verified in production; ISO instant, e.g. 2026-11-20T00:00:00Z.
ANALYTICS_COVERAGE_START=@ask-optional

# Matches {{EFFECTIVE_DATE}} of the published privacy notice, e.g. 2026-11-15.
PRIVACY_POLICY_VERSION=@ask
# G-PRIVACY approval, JSON on one line, e.g.
# {"accountDeletionApproved":true,"deletionReceiptDays":30}
# deletionReceiptDays must equal {{DELETION_RECEIPT_RETENTION}} in the privacy notice.
RETENTION_POLICY_JSON=@ask

LOG_LEVEL=info
# nginx on loopback is the only proxy in front of the API.
TRUSTED_PROXY_CIDRS=127.0.0.1
# Support inbox for the daily moderation digest (private value).
SUPPORT_EMAIL=@ask
MODERATION_AUTO_HIDE_REPORTERS=2

# Optional: report digest push to Ethan (being added on another branch; harmless until the
# code reads it). Leave empty until that change is merged.
ETHAN_MODERATION_URL=@ask-optional
ETHAN_MODERATION_TOKEN=@secret-optional
