# Template for /etc/fancy/web-build.env (root:root 0600), read only while release.sh builds
# the Web app. These end up inside the public JavaScript bundle, so they must be the
# browser key (Maps JavaScript API only, HTTP referrer https://fancyabite.uk/*) and the
# Web Map ID; never the server Places key. Same directive syntax as fancy.env.template.
VITE_PUBLIC_GOOGLE_MAPS_KEY=@ask-optional
VITE_PUBLIC_GOOGLE_MAPS_ID=@ask-optional
