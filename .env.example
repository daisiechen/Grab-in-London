# Names only. Real values come from a secret manager or an untracked .env; never commit them.
# ENVIRONMENT: development | test | staging | production
ENVIRONMENT=
# postgres:// URL; staging/production must use sslmode=require or verify-full
DATABASE_URL=
# Adapter selection; test/fixture/mock adapters are refused outside development/test
AUTH_ADAPTER=
PLACES_ADAPTER=
MAIL_ADAPTER=
AI_PROVIDER=
# Must stay unset outside development/test
DEV_FIXED_OTP=
# Origin of the web client (https in staging/production); cookie writes must come from it
WEB_ORIGIN=
# >=32 random chars from the secret manager (CSRF HMAC, rate-limit hashing)
SESSION_SECRET=
# Registered native OAuth redirect for iOS, e.g. a custom scheme (optional)
IOS_REDIRECT_URI=
# Required when AUTH_ADAPTER=auth0 (G-AUTH); secret via secret manager only
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
# Optional until G-PLACES is configured; google adapter returns unavailable without it
GOOGLE_MAPS_API_KEY=
# Secret; a Key alone never enables calls before model/price/counting and budget verification
DEEPSEEK_API_KEY=
AI_BUNDLE_FILE=
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=
# Dedicated AES-256-GCM key ring for deletion notices only; leave empty to use anonymous receipts.
DELETION_MAIL_KEY_VERSION=
DELETION_MAIL_KEYS_JSON=
# First confirmed coverage of deployed API + Web + iOS telemetry (ISO instant); unset = partial
ANALYTICS_COVERAGE_START=
# API listen port (default 3000)
PORT=
PRIVACY_POLICY_VERSION=
# JSON object approved under G-PRIVACY (staging/production)
RETENTION_POLICY_JSON=
LOG_LEVEL=
# Exact immediate proxy IPs/CIDRs, comma separated. Unset distrusts forwarded headers.
# Configure only controlled proxies that replace/append X-Forwarded-For; never all networks.
TRUSTED_PROXY_CIDRS=
# Support inbox for the daily moderation digest (optional; unset = no digest). Private value, not in git.
SUPPORT_EMAIL=
# Admin console URL used in digest links (optional; default WEB_ORIGIN + /admin/; https in staging/production)
ADMIN_URL=
# Distinct reporters within 7 days before reported content is limited automatically (default 2)
MODERATION_AUTO_HIDE_REPORTERS=
# Moderation push to the owner's assistant (Ethan): counts and an admin link only (optional; set both or neither).
# https in staging/production. The token is a private secret, not in git; it is never logged.
ETHAN_MODERATION_URL=
ETHAN_MODERATION_TOKEN=
