{
  "name": "fancy-core",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "core:check": "pnpm -r --workspace-concurrency=1 run typecheck && tsc -p infra/tsconfig.json && pnpm --filter @fancy/contracts run check:generated && eslint --max-warnings=0 . && node infra/scripts/secret-scan.mjs .",
    "core:test:unit": "vitest run --project unit",
    "core:test:db": "vitest run --project db",
    "core:test:api": "node infra/scripts/not-implemented.mjs core:test:api T04",
    "core:test:web": "node infra/scripts/not-implemented.mjs core:test:web T05",
    "core:test:ios": "node infra/scripts/not-implemented.mjs core:test:ios T24",
    "core:test:release": "vitest run --project release",
    "core:test": "pnpm core:test:unit && pnpm core:test:db && pnpm core:test:release",
    "core:test:clients": "vitest run --project web --project admin"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "jsdom": "30.1.2"
  }
}
